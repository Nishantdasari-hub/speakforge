# Database Configuration (local MySQL)
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/speakforge

# JWT Configuration
SECRET_KEY=your_super_secret_key_here_change_in_production

# Admin registration
ADMIN_SECRET_KEY=change_me_admin_key

# Email Configuration (leave MAIL_USERNAME empty to print the
# verification link to the server console instead of sending mail)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
USE_CREDENTIALS=True

# Public URLs used in verification emails / redirects
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173

# CORS Configuration (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Application Configuration
DEBUG=True
ENVIRONMENT=development
