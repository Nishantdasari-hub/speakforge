ENVIRONMENT=production
MYSQL_PASSWORD=change-this-password
MYSQL_ROOT_PASSWORD=change-this-root-password
VITE_API_URL=https://api.speakforge.example.com
DATABASE_URL=mysql+pymysql://speakforge:change-this-password@db:3306/speakforge
SECRET_KEY=generate-a-long-random-secret
ADMIN_SECRET_KEY=generate-a-separate-admin-secret
FRONTEND_URL=https://speakforge.example.com
BACKEND_URL=https://api.speakforge.example.com
ALLOWED_ORIGINS=https://speakforge.example.com
UPLOAD_DIR=/data/uploads
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@speakforge.example.com
MAIL_PORT=587
MAIL_SERVER=smtp.example.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
USE_CREDENTIALS=True